{
  "datasets": [
    {
      "name": "ds_sales",
      "displayName": "Denormalized Theater Sales",
      "queryLines": [
        "WITH d AS (\n",
        "  SELECT *\n",
        "  FROM IDENTIFIER(:catalog || '.' || :schema || '.denormalized_theater_sales')\n",
        "  WHERE showtime IS NOT NULL\n",
        "), bounds AS (\n",
        "  SELECT MAX(CAST(showtime AS DATE)) AS max_d FROM d\n",
        ")\n",
        "SELECT d.*\n",
        "FROM d, bounds\n",
        "WHERE CAST(d.showtime AS DATE) BETWEEN DATE_TRUNC('YEAR', max_d) AND max_d"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "workspace"
                }
              ]
            }
          }
        },
        {
          "displayName": "schema",
          "keyword": "schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "fde_theater"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_last_week_revenue",
      "displayName": "Last Week Revenue",
      "queryLines": [
        "WITH d AS (\n",
        "  SELECT theater_name, showtime, gross_revenue\n",
        "  FROM IDENTIFIER(:catalog || '.' || :schema || '.denormalized_theater_sales')\n",
        "  WHERE showtime IS NOT NULL\n",
        "), bounds AS (\n",
        "  SELECT MAX(CAST(showtime AS DATE)) AS max_d FROM d\n",
        ")\n",
        "SELECT theater_name, gross_revenue\n",
        "FROM d, bounds\n",
        "WHERE CAST(showtime AS DATE) BETWEEN DATE_SUB(max_d, 6) AND max_d"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "workspace"
                }
              ]
            }
          }
        },
        {
          "displayName": "schema",
          "keyword": "schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "fde_theater"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_last_week_tickets_by_hour",
      "displayName": "Last Week Tickets by Hour",
      "queryLines": [
        "WITH d AS (\n",
        "  SELECT theater_name, showtime, seats_sold\n",
        "  FROM IDENTIFIER(:catalog || '.' || :schema || '.denormalized_theater_sales')\n",
        "  WHERE showtime IS NOT NULL\n",
        "), bounds AS (\n",
        "  SELECT MAX(CAST(showtime AS DATE)) AS max_d FROM d\n",
        ")\n",
        "SELECT theater_name, CAST(HOUR(showtime) AS STRING) AS showtime_hour, seats_sold\n",
        "FROM d, bounds\n",
        "WHERE CAST(showtime AS DATE) BETWEEN DATE_SUB(max_d, 6) AND max_d"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "workspace"
                }
              ]
            }
          }
        },
        {
          "displayName": "schema",
          "keyword": "schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "fde_theater"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_downtime_ytd_by_dow",
      "displayName": "Downtime by Day of Week (YTD)",
      "queryLines": [
        "WITH d AS (\n",
        "  SELECT theater_name, open_time, close_time, screen_id, showtime, runtime_minutes\n",
        "  FROM IDENTIFIER(:catalog || '.' || :schema || '.denormalized_theater_sales')\n",
        "  WHERE showtime IS NOT NULL\n",
        "), bounds AS (\n",
        "  SELECT MAX(CAST(showtime AS DATE)) AS max_d FROM d\n",
        "), filtered AS (\n",
        "  SELECT d.* FROM d, bounds\n",
        "  WHERE CAST(d.showtime AS DATE) BETWEEN DATE_TRUNC('YEAR', max_d) AND max_d\n",
        "), daily AS (\n",
        "  SELECT theater_name, open_time, close_time, screen_id,\n",
        "    CAST(showtime AS DATE) AS show_date,\n",
        "    SUM(runtime_minutes) AS show_minutes\n",
        "  FROM filtered\n",
        "  GROUP BY theater_name, open_time, close_time, screen_id, CAST(showtime AS DATE)\n",
        ")\n",
        "SELECT theater_name,\n",
        "  CAST(DAYOFWEEK(show_date) AS INT) AS dow_num,\n",
        "  CONCAT(DAYOFWEEK(show_date), ' ', DATE_FORMAT(show_date, 'EEE')) AS day_of_week,\n",
        "  ((CASE WHEN close_time = '00:00' THEN 1440\n",
        "         ELSE CAST(SUBSTRING(close_time, 1, 2) AS INT) * 60 + CAST(SUBSTRING(close_time, 4, 2) AS INT)\n",
        "    END) - (CAST(SUBSTRING(open_time, 1, 2) AS INT) * 60 + CAST(SUBSTRING(open_time, 4, 2) AS INT)))\n",
        "    - show_minutes AS downtime_minutes\n",
        "FROM daily"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "workspace"
                }
              ]
            }
          }
        },
        {
          "displayName": "schema",
          "keyword": "schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "fde_theater"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_downtime_last_week_by_dow",
      "displayName": "Downtime by Day of Week (Last Week)",
      "queryLines": [
        "WITH d AS (\n",
        "  SELECT theater_name, open_time, close_time, screen_id, showtime, runtime_minutes\n",
        "  FROM IDENTIFIER(:catalog || '.' || :schema || '.denormalized_theater_sales')\n",
        "  WHERE showtime IS NOT NULL\n",
        "), bounds AS (\n",
        "  SELECT MAX(CAST(showtime AS DATE)) AS max_d FROM d\n",
        "), filtered AS (\n",
        "  SELECT d.* FROM d, bounds\n",
        "  WHERE CAST(d.showtime AS DATE) BETWEEN DATE_SUB(max_d, 6) AND max_d\n",
        "), daily AS (\n",
        "  SELECT theater_name, open_time, close_time, screen_id,\n",
        "    CAST(showtime AS DATE) AS show_date,\n",
        "    SUM(runtime_minutes) AS show_minutes\n",
        "  FROM filtered\n",
        "  GROUP BY theater_name, open_time, close_time, screen_id, CAST(showtime AS DATE)\n",
        ")\n",
        "SELECT theater_name,\n",
        "  CAST(DAYOFWEEK(show_date) AS INT) AS dow_num,\n",
        "  CONCAT(DAYOFWEEK(show_date), ' ', DATE_FORMAT(show_date, 'EEE')) AS day_of_week,\n",
        "  ((CASE WHEN close_time = '00:00' THEN 1440\n",
        "         ELSE CAST(SUBSTRING(close_time, 1, 2) AS INT) * 60 + CAST(SUBSTRING(close_time, 4, 2) AS INT)\n",
        "    END) - (CAST(SUBSTRING(open_time, 1, 2) AS INT) * 60 + CAST(SUBSTRING(open_time, 4, 2) AS INT)))\n",
        "    - show_minutes AS downtime_minutes\n",
        "FROM daily"
      ],
      "parameters": [
        {
          "displayName": "catalog",
          "keyword": "catalog",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "workspace"
                }
              ]
            }
          }
        },
        {
          "displayName": "schema",
